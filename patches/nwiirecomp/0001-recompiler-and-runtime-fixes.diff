 namespace nwii::runtime::hw {
 
+// AICR (0xCC006C00) bit layout, per the GameCube/Wii hardware documentation.
+enum : uint32_t {
+    AICR_PSTAT    = 0x01, // 1 = streaming sample counter runs
+    AICR_AISFR    = 0x02, // AIS sample rate: 0 = 32 kHz, 1 = 48 kHz
+    AICR_AIINTMSK = 0x04, // 1 = AI interrupt enabled
+    AICR_AIINT    = 0x08, // interrupt status; write 1 to clear
+    AICR_AIINTVLD = 0x10,
+    AICR_SCRESET  = 0x20, // write-only strobe: reset the sample counter
+    AICR_AIDFR    = 0x40, // DSP sample rate
+};
+constexpr uint32_t AICR_STORED = AICR_PSTAT | AICR_AISFR | AICR_AIINTMSK | AICR_AIINTVLD | AICR_AIDFR;
+constexpr uint32_t PI_INT_AI = 0x20;
+
 static uint32_t ai_cr = 0;
 static uint32_t ai_vr = 0;
-static uint32_t ai_scnt = 0;
+static uint32_t ai_scnt_base = 0;   // counter value at ai_start_time
+static uint64_t ai_start_time = 0;  // host microseconds
 static uint32_t ai_it = 0;
-static uint64_t ai_start_time = 0;
+static uint32_t ai_last_scnt = 0;   // last value checked against AIIT
+
+static uint32_t ai_rate() { return (ai_cr & AICR_AISFR) ? 48000 : 32000; }
+
+static uint32_t ai_current_scnt() {
+    if (!(ai_cr & AICR_PSTAT)) return ai_scnt_base;
+    uint64_t elapsed = nwii::runtime::get_os_time() - ai_start_time;
+    return ai_scnt_base + (uint32_t)((elapsed * ai_rate()) / 1000000);
+}
+
+// Re-anchor the counter so a rate or run-state change does not make it jump.
+static void ai_rebase() {
+    ai_scnt_base = ai_current_scnt();
+    ai_start_time = nwii::runtime::get_os_time();
+}
+
+static void ai_update_interrupts() {
+    if ((ai_cr & AICR_AIINT) && (ai_cr & AICR_AIINTMSK)) trigger_pi_interrupt(PI_INT_AI);
+    else clear_pi_interrupt(PI_INT_AI);
+}
+
+static uint32_t ai_tick() {
+    uint32_t cur = ai_current_scnt();
+    // Raise AIINT when the counter crosses AIIT (wrap-safe).
+    if (ai_it != 0 && cur != ai_last_scnt && (uint32_t)(ai_it - ai_last_scnt) <= (uint32_t)(cur - ai_last_scnt)) {
+        ai_cr |= AICR_AIINT;
+        ai_update_interrupts();
+    }
+    ai_last_scnt = cur;
+    return cur;
+}
 
